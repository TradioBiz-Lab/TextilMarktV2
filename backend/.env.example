PORT=3001
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=60m
NODE_ENV=development
MONGO_DB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# For local dev/manual verification without touching real data, copy this
# file to backend/.env.sandbox and give MONGO_DB_URI an explicit, distinct
# database name (e.g. .../textilmarkt_sandbox?appName=Cluster0) on the same
# cluster. Run it with `npm run dev:sandbox` / `npm run seed:sandbox` —
# see CLAUDE.md's "Local sandbox" section.
FRONTEND_URL=https://your-app.vercel.app

# Where a coordinator's photos and voice notes are kept (docs/RUNBOOK.md section 9). Leave both out to keep them in the
# database. STRATUS_BUCKET alone only names the bucket (so it can be checked); FILE_STORE=stratus switches it on.
# STRATUS_BUCKET=
# FILE_STORE=stratus

# Speech to text (Kriyaa's microphone, a coordinator's spoken update): ElevenLabs or Sarvam, whichever key is set.
# With both, ElevenLabs is used unless VOICE_STT=sarvam. Reading replies aloud is Sarvam only.
# ELEVENLABS_API_KEY=
# VOICE_STT=elevenlabs
