    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mongoose": "^8.24.10",
    "papaparse": "^5.7.0",
    "resend": "^6.9.4",
