{
  "name": "tradio-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "dev:sandbox": "node --env-file=.env.sandbox --watch src/app.js",
    "start": "node src/app.js",
    "seed:sandbox": "node --env-file=.env.sandbox src/db/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.23.0",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
